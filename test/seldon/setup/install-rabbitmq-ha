#!/bin/bash

# Install RabbitMQ using production rabbitmq-ha Helm chart
# This replaces the operator-based installation

set -o nounset -o errexit -o pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

echo ">>> Creating namespace..."
kubectl create namespace rabbitmq --dry-run=client -o yaml | kubectl apply -f -

# Note: seldon-regression-test namespace should already exist from install-test-namespace
# (called before this script in install-all). If running standalone, ensure it exists first.

echo ">>> Creating domino-quay-repos secret for pulling Domino docker images..."
kubectl create secret -n rabbitmq docker-registry domino-quay-repos \
  --docker-username="${DOCKER_USERNAME}" \
  --docker-password="${DOCKER_PASSWORD}" \
  --docker-server="${DOCKER_REGISTRY}" \
  --dry-run=client -o yaml | kubectl apply -f -

echo ">>> Creating seldon user secret..."
kubectl apply -f "${SCRIPT_DIR}/manifests/rabbitmq/seldon-user-secret.yaml"

echo ">>> Authenticating with GCR for Helm chart access..."
# Authenticate with GCR if credentials are available
# GCR_PASSWORD should be a base64-encoded JSON key
if [ -n "${GCR_PASSWORD:-}" ]; then
  echo "$GCR_PASSWORD" | base64 --decode | helm registry login -u _json_key --password-stdin gcr.io
elif [ -n "${GCR_HELM_KEY_BASE64:-}" ]; then
  # Alternative: GCR_HELM_KEY_BASE64 (used in CircleCI)
  echo "$GCR_HELM_KEY_BASE64" | base64 --decode | helm registry login -u _json_key --password-stdin gcr.io
else
  echo "Warning: GCR_PASSWORD or GCR_HELM_KEY_BASE64 not set. Attempting to use existing Helm credentials..."
  echo "If this fails, set GCR_PASSWORD (base64-encoded JSON key) or GCR_HELM_KEY_BASE64 environment variable."
fi

echo ">>> Installing rabbitmq-ha chart..."
# Install from OCI registry
# Note: Not using --wait as it can timeout; we'll check pod readiness manually instead
if ! helm upgrade --install rabbitmq-ha \
  oci://gcr.io/domino-eng-service-artifacts/rabbitmq-ha \
  --version 2.2.0-r13 \
  --namespace rabbitmq \
  --values "${SCRIPT_DIR}/manifests/rabbitmq/rabbitmq-ha-values.yaml"; then
  echo "ERROR: Helm install failed"
  kubectl get pods -n rabbitmq -l app.kubernetes.io/name=rabbitmq-ha || true
  kubectl get statefulset -n rabbitmq || true
  exit 1
fi

echo ">>> Chart installed, waiting for resources to be created..."
sleep 10

echo ">>> Waiting for RabbitMQ pod to be ready..."
kubectl wait --for=condition=Ready pod -l app.kubernetes.io/name=rabbitmq-ha \
  --timeout=300s -n rabbitmq || {
    echo "ERROR: RabbitMQ pod not ready after timeout, gathering diagnostics..."
    
    # Get pod name
    RABBITMQ_POD=$(kubectl get pods -n rabbitmq -l app.kubernetes.io/name=rabbitmq-ha -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "")
    
    if [ -n "$RABBITMQ_POD" ]; then
      echo ">>> Pod status:"
      kubectl get pods -n rabbitmq -l app.kubernetes.io/name=rabbitmq-ha || true
      
      echo ""
      echo ">>> Pod description:"
      kubectl describe pod -n rabbitmq "$RABBITMQ_POD" || true
      
      echo ""
      echo ">>> Pod events:"
      kubectl get events -n rabbitmq --field-selector involvedObject.name="$RABBITMQ_POD" --sort-by='.lastTimestamp' || true
      
      echo ""
      echo ">>> Pod logs (main container):"
      kubectl logs -n rabbitmq "$RABBITMQ_POD" || true
      
      # Check for init containers
      INIT_CONTAINERS=$(kubectl get pod -n rabbitmq "$RABBITMQ_POD" -o jsonpath='{.spec.initContainers[*].name}' 2>/dev/null || echo "")
      if [ -n "$INIT_CONTAINERS" ]; then
        for INIT_CONTAINER in $INIT_CONTAINERS; do
          echo ""
          echo ">>> Pod logs (init container: $INIT_CONTAINER):"
          kubectl logs -n rabbitmq "$RABBITMQ_POD" -c "$INIT_CONTAINER" || true
        done
      fi
    else
      echo "ERROR: No RabbitMQ pod found"
      kubectl get pods -n rabbitmq -l app.kubernetes.io/name=rabbitmq-ha || true
      kubectl get statefulset -n rabbitmq || true
    fi
    
    exit 1
  }

echo ">>> Creating RabbitMQ queues..."
"${SCRIPT_DIR}/create-rabbitmq-queues.sh"

echo ">>> Verifying RabbitMQ service..."
kubectl get svc rabbitmq-ha -n rabbitmq

echo ">>> Done installing RabbitMQ (rabbitmq-ha chart)."

