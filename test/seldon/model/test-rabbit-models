#!/bin/bash

# Test script for RabbitMQ models using rabbitmq-ha chart

set -o nounset -o errexit -o pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
MODELS_DIR=$SCRIPT_DIR/../../models
COMMON_DIR=$SCRIPT_DIR/../common

source "${COMMON_DIR}/with_backoff.sh"

COMPUTE_NAMESPACE=seldon-regression-test
RABBITMQ_NAMESPACE=rabbitmq

echo ">>> Getting RabbitMQ credentials..."
# Use seldon user for management API access (has management tag)
# seldon user credentials are in secret 'rabbitmq-ha.seldon'
RABBITMQ_USER="seldon"
RABBITMQ_PASSWORD=""

if kubectl get secret rabbitmq-ha.seldon -n ${RABBITMQ_NAMESPACE} &>/dev/null; then
  RABBITMQ_PASSWORD=$(kubectl -n ${RABBITMQ_NAMESPACE} get secret rabbitmq-ha.seldon -o jsonpath="{.data.rabbitmq-password}" | base64 --decode 2>/dev/null || echo "")
fi

# Fallback to default password if secret not found
if [ -z "$RABBITMQ_PASSWORD" ]; then
  RABBITMQ_PASSWORD="seldon-password"
fi

if [ -z "$RABBITMQ_USER" ] || [ -z "$RABBITMQ_PASSWORD" ]; then
  echo "ERROR: Could not determine RabbitMQ credentials"
  exit 1
fi

echo ">>> Getting RabbitMQ pod name..."
RABBITMQ_POD=$(kubectl get pods -n ${RABBITMQ_NAMESPACE} -l app.kubernetes.io/name=rabbitmq-ha -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "")

if [ -z "$RABBITMQ_POD" ]; then
  echo "ERROR: RabbitMQ pod not found"
  exit 1
fi

EXPECTED_IRIS_RESULT_PAYLOAD='{"data":{"names":["t:0","t:1","t:2"],"ndarray":[[0.0006985194531162835,0.00366803903943666,0.995633441507447]]},"meta":{"requestPath":{"classifier":"seldonio/sklearnserver:1.17.1"}}}'

echo ">>> Setting up port-forward to RabbitMQ Management API..."
# Use port-forward to access Management API since curl is not available in container
kubectl -n ${RABBITMQ_NAMESPACE} port-forward ${RABBITMQ_POD} 15672:15672 > /dev/null 2>&1 &
PORT_FORWARD_PID=$!
sleep 2

echo ">>> Running RabbitMQ connectivity test (independent of model pods)..."
# Create a test queue for connectivity check
TEST_QUEUE="test-connectivity-$(date +%s)"
TEST_MESSAGE='{"test":"message"}'

# Create test queue
curl -s -X PUT "http://localhost:15672/api/queues/%2F/${TEST_QUEUE}" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" \
    -H "Content-type: application/json" \
    -H "Accept: application/json" \
    -d '{"auto_delete":true,"durable":false,"arguments":{}}' > /dev/null 2>&1

# Publish test message (payload must be a JSON-escaped string when payload_encoding is "string")
# Use jq -Rs to read as raw string and output as JSON string
TEST_MESSAGE_ESCAPED=$(echo "$TEST_MESSAGE" | jq -Rs .)
PUBLISH_TEST_RESPONSE=$(curl -s -X POST "http://localhost:15672/api/exchanges/%2F/amq.default/publish" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" \
    -H "Content-type: application/json" \
    -H "Accept: application/json" \
    -d "{\"properties\":{\"content_type\":\"application/json\"},\"routing_key\":\"${TEST_QUEUE}\",\"payload\":${TEST_MESSAGE_ESCAPED},\"payload_encoding\":\"string\"}")

if echo "$PUBLISH_TEST_RESPONSE" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: RabbitMQ connectivity test failed - cannot publish: $PUBLISH_TEST_RESPONSE" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

PUBLISH_TEST_ROUTED=$(echo "$PUBLISH_TEST_RESPONSE" | jq -r '.routed // false' 2>/dev/null)
if [ "$PUBLISH_TEST_ROUTED" != "true" ]; then
  echo "ERROR: RabbitMQ connectivity test failed - message not routed: $PUBLISH_TEST_RESPONSE" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

# Consume test message
sleep 1
CONSUME_TEST_RESPONSE=$(curl -s -X POST "http://localhost:15672/api/queues/%2F/${TEST_QUEUE}/get" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" \
    -H "Content-type: application/json" \
    -H "Accept: application/json" \
    -d '{"count":1,"ackmode":"ack_requeue_false","encoding":"auto"}')

if echo "$CONSUME_TEST_RESPONSE" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: RabbitMQ connectivity test failed - cannot consume: $CONSUME_TEST_RESPONSE" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

CONSUMED_MESSAGE=$(echo "$CONSUME_TEST_RESPONSE" | jq -r '.[0].payload // empty' 2>/dev/null)
# Compare JSON content (not exact string match, as formatting may differ)
if [ -z "$CONSUMED_MESSAGE" ]; then
  echo "ERROR: RabbitMQ connectivity test failed - no message consumed" >&2
  echo "  Response: $CONSUME_TEST_RESPONSE" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

# Verify the consumed message contains the expected content
if ! echo "$CONSUMED_MESSAGE" | jq -e '.test == "message"' > /dev/null 2>&1; then
  echo "ERROR: RabbitMQ connectivity test failed - message content mismatch" >&2
  echo "  Expected: $TEST_MESSAGE" >&2
  echo "  Got: $CONSUMED_MESSAGE" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

# Clean up test queue
curl -s -X DELETE "http://localhost:15672/api/queues/%2F/${TEST_QUEUE}" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" > /dev/null 2>&1

echo "✓ RabbitMQ connectivity test passed"

echo ">>> Checking if model deployment is ready..."
if ! kubectl wait deployment.apps/iris-model-rabbitmq-default-0-classifier -n ${COMPUTE_NAMESPACE} --for condition=Available=True --timeout=30s 2>/dev/null; then
  echo "WARNING: Model deployment may not be ready. Continuing anyway..."
fi

# Give model pods time to connect to RabbitMQ after deployment is ready
# This is important in fresh clusters where everything starts from scratch
# The executor needs time to:
# 1. Start up
# 2. Read environment variables
# 3. Establish connection to RabbitMQ
# 4. Create consumer and register with the queue
echo ">>> Waiting for model pods to establish RabbitMQ connections..."
sleep 20

echo ">>> Verifying model secret exists..."
if ! kubectl get secret seldon-user-user-credentials -n ${COMPUTE_NAMESPACE} &>/dev/null; then
  echo "ERROR: Secret 'seldon-user-user-credentials' not found in namespace ${COMPUTE_NAMESPACE}" >&2
  echo "This secret is required for the model to connect to RabbitMQ." >&2
  exit 1
fi

# Verify secret credentials match RabbitMQ user
SECRET_USERNAME=$(kubectl get secret seldon-user-user-credentials -n ${COMPUTE_NAMESPACE} -o jsonpath='{.data.username}' | base64 --decode 2>/dev/null || echo "")
SECRET_PASSWORD=$(kubectl get secret seldon-user-user-credentials -n ${COMPUTE_NAMESPACE} -o jsonpath='{.data.password}' | base64 --decode 2>/dev/null || echo "")

if [ "$SECRET_USERNAME" != "$RABBITMQ_USER" ]; then
  echo "WARNING: Secret username ($SECRET_USERNAME) does not match expected RabbitMQ user ($RABBITMQ_USER)" >&2
fi

if [ "$SECRET_PASSWORD" != "$RABBITMQ_PASSWORD" ]; then
  echo "WARNING: Secret password does not match expected RabbitMQ password" >&2
  echo "This may prevent the model from connecting to RabbitMQ." >&2
fi

echo "Secret verified: username=$SECRET_USERNAME"

echo ">>> Checking model pod status..."
MODEL_PODS=$(kubectl get pods -n ${COMPUTE_NAMESPACE} -l seldon-deployment-id=iris-model-rabbitmq -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || echo "")
if [ -z "$MODEL_PODS" ]; then
  echo "WARNING: No model pods found. Model may not be deployed correctly." >&2
else
  echo "Model pods: $MODEL_PODS"
  ALL_READY=true
  for pod in $MODEL_PODS; do
    POD_STATUS=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.phase}' 2>/dev/null || echo "Unknown")
    POD_READY=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "Unknown")
    echo "  Pod $pod: $POD_STATUS (Ready: $POD_READY)"
    if [ "$POD_READY" != "True" ]; then
      ALL_READY=false
    fi
  done
  
  if [ "$ALL_READY" != "true" ]; then
    echo "WARNING: Some model pods are not ready. They may still be starting up or have issues." >&2
    echo "Waiting additional time for pods to become ready..." >&2
    sleep 10
  fi
fi

echo ">>> Verifying RabbitMQ service is accessible..."
if ! kubectl get svc rabbitmq-ha -n ${RABBITMQ_NAMESPACE} &>/dev/null; then
  echo "ERROR: RabbitMQ service 'rabbitmq-ha' not found in namespace ${RABBITMQ_NAMESPACE}" >&2
  exit 1
fi

RABBITMQ_SVC_IP=$(kubectl get svc rabbitmq-ha -n ${RABBITMQ_NAMESPACE} -o jsonpath='{.spec.clusterIP}' 2>/dev/null || echo "")
RABBITMQ_SVC_PORT=$(kubectl get svc rabbitmq-ha -n ${RABBITMQ_NAMESPACE} -o jsonpath='{.spec.ports[?(@.name=="amqp")].port}' 2>/dev/null || echo "5672")
echo "RabbitMQ service: clusterIP=$RABBITMQ_SVC_IP, port=$RABBITMQ_SVC_PORT"

echo ">>> Verifying queues exist (using existing port-forward)..."
INPUT_QUEUE_INFO=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-input" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
OUTPUT_QUEUE_INFO=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-output" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")

if echo "$INPUT_QUEUE_INFO" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: Input queue does not exist: $INPUT_QUEUE_INFO" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

if echo "$OUTPUT_QUEUE_INFO" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: Output queue does not exist: $OUTPUT_QUEUE_INFO" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

echo ">>> Queues verified. Sending predict message to iris rabbitmq model input queue..."

PUBLISH_RESPONSE=$(curl -s -X POST "http://localhost:15672/api/exchanges/%2F/amq.default/publish" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" \
    -H "Content-type: application/json" \
    -H "Accept: application/json" \
    -d '{"properties":{"content_type":"application/json"},"routing_key":"iris-model-rabbitmq-input","payload":"{\"data\": {\"ndarray\": [[1,2,3,4]] }}","payload_encoding":"string"}')

# Check if publish was successful
if echo "$PUBLISH_RESPONSE" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: Failed to publish message: $PUBLISH_RESPONSE" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

# Verify publish response indicates success
PUBLISH_ROUTED=$(echo "$PUBLISH_RESPONSE" | jq -r '.routed // false' 2>/dev/null)
if [ "$PUBLISH_ROUTED" != "true" ]; then
  echo "WARNING: Publish response indicates message may not have been routed: $PUBLISH_RESPONSE" >&2
fi

echo ">>> Message published successfully (routed: $PUBLISH_ROUTED). Verifying message reached input queue..."

# Wait a moment for message to be routed to queue
sleep 1

# Check input queue to verify message arrived
INPUT_QUEUE_BEFORE=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-input" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
INPUT_MESSAGES_BEFORE=$(echo "$INPUT_QUEUE_BEFORE" | jq -r '.messages // 0' 2>/dev/null || echo "unknown")
INPUT_CONSUMERS_BEFORE=$(echo "$INPUT_QUEUE_BEFORE" | jq -r '.consumers // 0' 2>/dev/null || echo "unknown")

echo "Input queue status: messages=$INPUT_MESSAGES_BEFORE, consumers=$INPUT_CONSUMERS_BEFORE"

if [ "$INPUT_MESSAGES_BEFORE" = "0" ] || [ "$INPUT_MESSAGES_BEFORE" = "unknown" ]; then
  echo "WARNING: No messages in input queue after publishing. Message may not have been routed correctly." >&2
  echo "Publish response: $PUBLISH_RESPONSE" >&2
fi

if [ "$INPUT_CONSUMERS_BEFORE" = "0" ] || [ "$INPUT_CONSUMERS_BEFORE" = "unknown" ]; then
  echo "WARNING: No consumers connected to input queue! Model may not be consuming messages." >&2
  
  # Run diagnostics before waiting
  echo ">>> Running diagnostics for consumers=0 issue..." >&2
  DIAGNOSTIC_FAILED=false
  
  # Check if secret exists
  if ! kubectl get secret seldon-user-user-credentials -n ${COMPUTE_NAMESPACE} &>/dev/null; then
    echo "ERROR: Secret 'seldon-user-user-credentials' not found in namespace ${COMPUTE_NAMESPACE}" >&2
    DIAGNOSTIC_FAILED=true
  else
    echo "✓ Secret exists" >&2
  fi
  
  # Check model pod status
  MODEL_PODS=$(kubectl get pods -n ${COMPUTE_NAMESPACE} -l seldon-deployment-id=iris-model-rabbitmq -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || echo "")
  if [ -z "$MODEL_PODS" ]; then
    echo "ERROR: No model pods found" >&2
    DIAGNOSTIC_FAILED=true
  else
    echo "✓ Found model pods: $MODEL_PODS" >&2
    # Check each pod's status and get logs
    for pod in $MODEL_PODS; do
      POD_STATUS=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.phase}' 2>/dev/null || echo "Unknown")
      POD_READY=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "Unknown")
      echo "  Pod $pod: phase=$POD_STATUS, ready=$POD_READY" >&2
      
      # Get recent logs for RabbitMQ-related errors
      echo "  Checking logs for RabbitMQ connection issues..." >&2
      LOG_OUTPUT=$(kubectl logs $pod -n ${COMPUTE_NAMESPACE} -c classifier --tail=100 2>&1 || echo "")
      if echo "$LOG_OUTPUT" | grep -i -E "(rabbitmq|amqp|connection|error|failed|exception|traceback)" >&2; then
        echo "  ^ Found RabbitMQ/error-related log entries above" >&2
      else
        echo "  (No obvious RabbitMQ errors in recent logs)" >&2
        # Show last few lines of logs anyway for context
        echo "  Last 10 lines of logs:" >&2
        echo "$LOG_OUTPUT" | tail -10 | sed 's/^/    /' >&2
      fi
      
      # Check environment variables - look for the specific RabbitMQ config vars
      # Note: With serverType=rabbitmq, env vars in svcOrchSpec should be on the orchestrator container, not classifier
      echo "  Checking RabbitMQ environment variables..." >&2
      
      # Initialize to empty string to avoid unbound variable error
      RABBITMQ_ENV=""
      
      # First check classifier container (model container)
      RABBITMQ_ENV_CLASSIFIER=$(kubectl exec $pod -n ${COMPUTE_NAMESPACE} -c classifier -- env 2>&1 | grep -E "^RABBITMQ_(BROKER_URL|USERNAME|PASSWORD|INPUT_QUEUE|OUTPUT_QUEUE)=" || echo "")
      
      # List all containers in the pod
      ALL_CONTAINERS=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.spec.containers[*].name}' 2>/dev/null || echo "")
      echo "  All containers in pod: $ALL_CONTAINERS" >&2
      
      # Check if there's an orchestrator container (for serverType=rabbitmq)
      # Seldon Core uses "seldon-container-engine" as the orchestrator container name
      ORCHESTRATOR_CONTAINER=$(echo "$ALL_CONTAINERS" | grep -oE '\b(seldon-container-engine|orchestrator)\b' || echo "")
      
      if [ -n "$ORCHESTRATOR_CONTAINER" ]; then
        echo "  Found orchestrator container ($ORCHESTRATOR_CONTAINER), checking it for RabbitMQ env vars..." >&2
        # Check orchestrator container status
        ORCH_READY=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.containerStatuses[?(@.name=="'$ORCHESTRATOR_CONTAINER'")].ready}' 2>/dev/null || echo "unknown")
        ORCH_RESTARTS=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.containerStatuses[?(@.name=="'$ORCHESTRATOR_CONTAINER'")].restartCount}' 2>/dev/null || echo "unknown")
        echo "    Orchestrator container status: ready=$ORCH_READY, restarts=$ORCH_RESTARTS" >&2
        
        # Try to get env vars (may fail if container isn't ready)
        RABBITMQ_ENV_ORCH=$(kubectl exec $pod -n ${COMPUTE_NAMESPACE} -c $ORCHESTRATOR_CONTAINER -- env 2>&1 | grep -E "^RABBITMQ_(BROKER_URL|USERNAME|PASSWORD|INPUT_QUEUE|OUTPUT_QUEUE)=" || echo "")
        if [ -n "$RABBITMQ_ENV_ORCH" ]; then
          echo "  Found RabbitMQ configuration in orchestrator container:" >&2
          echo "$RABBITMQ_ENV_ORCH" | sed 's/^/    /' >&2
          RABBITMQ_ENV="$RABBITMQ_ENV_ORCH"
        else
          echo "  No RabbitMQ env vars found in orchestrator container" >&2
          # Get orchestrator logs to see if there are connection errors
          echo "  Checking orchestrator container logs..." >&2
          ORCH_LOGS=$(kubectl logs $pod -n ${COMPUTE_NAMESPACE} -c $ORCHESTRATOR_CONTAINER --tail=30 2>&1 || echo "Could not retrieve logs")
          if echo "$ORCH_LOGS" | grep -i -E "(rabbitmq|amqp|error|failed|exception)" >&2; then
            echo "  ^ Found RabbitMQ/error-related log entries above" >&2
          fi
        fi
      else
        echo "  WARNING: No orchestrator container found. Expected 'seldon-container-engine' for serverType=rabbitmq" >&2
      fi
      
      if [ -z "$RABBITMQ_ENV" ] && [ -n "$RABBITMQ_ENV_CLASSIFIER" ]; then
        echo "  Found RabbitMQ configuration in classifier container:" >&2
        echo "$RABBITMQ_ENV_CLASSIFIER" | sed 's/^/    /' >&2
        RABBITMQ_ENV="$RABBITMQ_ENV_CLASSIFIER"
      fi
      
      if [ -z "$RABBITMQ_ENV" ]; then
        echo "  ERROR: Required RabbitMQ environment variables not found in any container" >&2
        echo "  Expected: RABBITMQ_BROKER_URL, RABBITMQ_USERNAME, RABBITMQ_PASSWORD, RABBITMQ_INPUT_QUEUE, RABBITMQ_OUTPUT_QUEUE" >&2
        echo "  Note: With serverType=rabbitmq, these should be in svcOrchSpec.env and applied to the orchestrator container" >&2
        DIAGNOSTIC_FAILED=true
      else
        # Verify all required vars are present
        if ! echo "$RABBITMQ_ENV" | grep -q "RABBITMQ_BROKER_URL="; then
          echo "  ERROR: RABBITMQ_BROKER_URL not set" >&2
          DIAGNOSTIC_FAILED=true
        fi
        if ! echo "$RABBITMQ_ENV" | grep -q "RABBITMQ_USERNAME="; then
          echo "  ERROR: RABBITMQ_USERNAME not set" >&2
          DIAGNOSTIC_FAILED=true
        fi
        if ! echo "$RABBITMQ_ENV" | grep -q "RABBITMQ_PASSWORD="; then
          echo "  ERROR: RABBITMQ_PASSWORD not set" >&2
          DIAGNOSTIC_FAILED=true
        fi
      fi
      
      # Check why pod is not ready
      if [ "$POD_READY" != "True" ]; then
        echo "  Pod is not ready. Checking readiness conditions..." >&2
        kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.conditions[?(@.type=="Ready")]}' 2>&1 | jq -r 'if type=="array" then .[] | "    \(.type): \(.status) - \(.reason // "no reason") - \(.message // "no message")" else . end' >&2 || true
        # Check container status
        CONTAINER_READY=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.containerStatuses[?(@.name=="classifier")].ready}' 2>/dev/null || echo "unknown")
        CONTAINER_RESTART_COUNT=$(kubectl get pod $pod -n ${COMPUTE_NAMESPACE} -o jsonpath='{.status.containerStatuses[?(@.name=="classifier")].restartCount}' 2>/dev/null || echo "unknown")
        echo "    Container ready: $CONTAINER_READY, restart count: $CONTAINER_RESTART_COUNT" >&2
        if [ "$CONTAINER_RESTART_COUNT" != "0" ] && [ "$CONTAINER_RESTART_COUNT" != "unknown" ]; then
          echo "    WARNING: Container has restarted $CONTAINER_RESTART_COUNT times - may indicate startup failures" >&2
        fi
      fi
    done
  fi
  
  # Check RabbitMQ service endpoints
  echo ">>> Checking RabbitMQ service endpoints..." >&2
  RABBITMQ_ENDPOINTS=$(kubectl get endpoints rabbitmq-ha -n ${RABBITMQ_NAMESPACE} -o json 2>/dev/null || echo "{}")
  ENDPOINT_ADDRESSES=$(echo "$RABBITMQ_ENDPOINTS" | jq -r '.subsets[0].addresses // [] | length' 2>/dev/null || echo "0")
  ENDPOINT_PORTS=$(echo "$RABBITMQ_ENDPOINTS" | jq -r '.subsets[0].ports // []' 2>/dev/null || echo "[]")
  echo "  Service endpoints: $ENDPOINT_ADDRESSES addresses" >&2
  if [ "$ENDPOINT_ADDRESSES" = "0" ]; then
    echo "  ERROR: RabbitMQ service has no endpoints! Service selector may not match pod labels." >&2
    DIAGNOSTIC_FAILED=true
  else
    echo "  Endpoint ports:" >&2
    echo "$ENDPOINT_PORTS" | jq -r '.[] | "    - \(.name): port=\(.port), targetPort=\(.targetPort)"' >&2 || true
    # Check if AMQP port (5672) is in the endpoints
    if ! echo "$ENDPOINT_PORTS" | jq -e '.[] | select(.name == "amqp" or .port == 5672)' > /dev/null 2>&1; then
      echo "  WARNING: AMQP port (5672) not found in service endpoints" >&2
      DIAGNOSTIC_FAILED=true
    fi
  fi
  
  # Check if RabbitMQ pod is listening on port 5672
  echo ">>> Checking if RabbitMQ pod is listening on port 5672..." >&2
  if kubectl -n ${RABBITMQ_NAMESPACE} exec ${RABBITMQ_POD} -c rabbitmq-ha -- \
    sh -c "nc -z localhost 5672 2>/dev/null || ss -tlnp 2>/dev/null | grep -q ':5672 ' || netstat -tlnp 2>/dev/null | grep -q ':5672 '" 2>/dev/null; then
    echo "  ✓ RabbitMQ pod is listening on port 5672" >&2
  else
    echo "  ERROR: RabbitMQ pod is NOT listening on port 5672" >&2
    echo "  This may indicate RabbitMQ is still starting up or failed to start" >&2
    DIAGNOSTIC_FAILED=true
  fi
  
  # Test connectivity from a model pod to RabbitMQ service
  # Note: The connectivity test uses port-forward (host->pod), which works
  # But model pods connect via service (pod->service->pod), which may be blocked
  echo ">>> Testing connectivity from model pod to RabbitMQ service (same path orchestrator uses)..." >&2
  FIRST_MODEL_POD=$(echo "$MODEL_PODS" | awk '{print $1}')
  if [ -n "$FIRST_MODEL_POD" ]; then
    # Try DNS resolution first
    echo "  Testing DNS resolution..." >&2
    DNS_RESULT=$(kubectl exec ${FIRST_MODEL_POD} -n ${COMPUTE_NAMESPACE} -c seldon-container-engine -- \
      sh -c "nslookup rabbitmq-ha.rabbitmq.svc.cluster.local 2>&1 || getent hosts rabbitmq-ha.rabbitmq.svc.cluster.local 2>&1" 2>/dev/null || echo "DNS_FAILED")
    if [ "$DNS_RESULT" != "DNS_FAILED" ] && echo "$DNS_RESULT" | grep -q "rabbitmq-ha"; then
      echo "  ✓ DNS resolution works" >&2
      echo "$DNS_RESULT" | head -3 | sed 's/^/    /' >&2
    else
      echo "  ERROR: DNS resolution failed" >&2
      DIAGNOSTIC_FAILED=true
    fi
    
    # Try to connect to RabbitMQ service from model pod (same way orchestrator does)
    echo "  Testing TCP connection to rabbitmq-ha.rabbitmq.svc.cluster.local:5672..." >&2
    CONNECT_RESULT=$(kubectl exec ${FIRST_MODEL_POD} -n ${COMPUTE_NAMESPACE} -c seldon-container-engine -- \
      sh -c "timeout 5 nc -zv rabbitmq-ha.rabbitmq.svc.cluster.local 5672 2>&1 || timeout 5 sh -c 'exec 3<>/dev/tcp/rabbitmq-ha.rabbitmq.svc.cluster.local/5672 && echo connected && exec 3<&- && exec 3>&-' 2>&1" 2>/dev/null || echo "CONNECT_FAILED")
    if echo "$CONNECT_RESULT" | grep -qiE "(succeeded|open|connected)"; then
      echo "  ✓ Model pod can reach RabbitMQ service on port 5672" >&2
    else
      echo "  ERROR: Model pod CANNOT reach RabbitMQ service on port 5672" >&2
      echo "  Connection result: $CONNECT_RESULT" >&2
      echo "  This indicates a network connectivity issue:" >&2
      echo "    - Network policy may be blocking traffic from ${COMPUTE_NAMESPACE} to ${RABBITMQ_NAMESPACE}" >&2
      echo "    - Service routing may not be working correctly" >&2
      echo "    - Note: Port-forward works (host->pod), but service routing (pod->service->pod) fails" >&2
      
      # Check for network policies that might be blocking the connection
      echo "  Checking for network policies..." >&2
      NP_IN_COMPUTE=$(kubectl get networkpolicies -n ${COMPUTE_NAMESPACE} -o name 2>/dev/null | wc -l || echo "0")
      NP_IN_RABBITMQ=$(kubectl get networkpolicies -n ${RABBITMQ_NAMESPACE} -o name 2>/dev/null | wc -l || echo "0")
      if [ "$NP_IN_COMPUTE" != "0" ] || [ "$NP_IN_RABBITMQ" != "0" ]; then
        echo "  Found network policies:" >&2
        echo "    - ${COMPUTE_NAMESPACE} namespace: $NP_IN_COMPUTE network policy(ies)" >&2
        echo "    - ${RABBITMQ_NAMESPACE} namespace: $NP_IN_RABBITMQ network policy(ies)" >&2
        echo "  Network policies may be blocking inter-namespace traffic" >&2
        echo "  Check for:" >&2
        echo "    - Egress policies in ${COMPUTE_NAMESPACE} blocking traffic to ${RABBITMQ_NAMESPACE}" >&2
        echo "    - Ingress policies in ${RABBITMQ_NAMESPACE} blocking traffic from ${COMPUTE_NAMESPACE}" >&2
      else
        echo "  No network policies found in either namespace" >&2
      fi
      DIAGNOSTIC_FAILED=true
    fi
  fi
  
  # Check RabbitMQ connections from RabbitMQ side
  echo ">>> Checking RabbitMQ connections..." >&2
  RABBITMQ_CONNECTIONS=$(curl -s -u "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" "http://localhost:15672/api/connections" 2>/dev/null || echo "[]")
  CONNECTION_COUNT=$(echo "$RABBITMQ_CONNECTIONS" | jq -r 'length // 0' 2>/dev/null || echo "0")
  echo "  RabbitMQ reports $CONNECTION_COUNT active connections" >&2
  if [ "$CONNECTION_COUNT" = "0" ]; then
    echo "  WARNING: No connections to RabbitMQ from any client" >&2
    DIAGNOSTIC_FAILED=true
  else
    echo "  Connection details:" >&2
    echo "$RABBITMQ_CONNECTIONS" | jq -r '.[] | "    - \(.name // "unnamed"): user=\(.user), state=\(.state)"' >&2 || true
  fi
  
  # Check Seldon Core operator logs for errors processing the SeldonDeployment
  echo ">>> Checking Seldon Core operator logs for SeldonDeployment processing errors..." >&2
  OPERATOR_NAMESPACE=$(kubectl get deployment -A -l app.kubernetes.io/name=seldon-core-operator -o jsonpath='{.items[0].metadata.namespace}' 2>/dev/null || echo "")
  if [ -n "$OPERATOR_NAMESPACE" ]; then
    OPERATOR_POD=$(kubectl get pods -n "$OPERATOR_NAMESPACE" -l app.kubernetes.io/name=seldon-core-operator -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "")
    if [ -n "$OPERATOR_POD" ]; then
      echo "  Operator pod: $OPERATOR_POD in namespace $OPERATOR_NAMESPACE" >&2
      # Look for errors related to the iris-model-rabbitmq deployment
      OPERATOR_LOGS=$(kubectl logs "$OPERATOR_POD" -n "$OPERATOR_NAMESPACE" --tail=100 2>&1 | grep -i -E "(iris-model-rabbitmq|svcOrchSpec|rabbitmq|error|failed)" || echo "")
      if [ -n "$OPERATOR_LOGS" ]; then
        echo "  Found relevant operator log entries:" >&2
        echo "$OPERATOR_LOGS" | sed 's/^/    /' >&2
      else
        echo "  (No obvious errors in recent operator logs related to iris-model-rabbitmq)" >&2
      fi
    fi
  fi
  
  # Check the actual SeldonDeployment resource to see if svcOrchSpec is present
  echo ">>> Checking SeldonDeployment resource configuration..." >&2
  SD_SPEC=$(kubectl get seldondeployment iris-model-rabbitmq -n ${COMPUTE_NAMESPACE} -o json 2>/dev/null || echo "{}")
  if echo "$SD_SPEC" | jq -e '.spec.predictors[0].svcOrchSpec' > /dev/null 2>&1; then
    SVC_ORCH_ENV=$(echo "$SD_SPEC" | jq -r '.spec.predictors[0].svcOrchSpec.env // []' 2>/dev/null || echo "[]")
    if echo "$SVC_ORCH_ENV" | jq -e 'length > 0' > /dev/null 2>&1; then
      echo "  ✓ svcOrchSpec.env is present in SeldonDeployment with $(echo "$SVC_ORCH_ENV" | jq 'length') env vars" >&2
      echo "  Env vars in svcOrchSpec:" >&2
      echo "$SVC_ORCH_ENV" | jq -r '.[] | "    - \(.name): \(if .value then .value else "from secret" end)"' >&2 || true
    else
      echo "  ERROR: svcOrchSpec.env is empty or missing in SeldonDeployment" >&2
      DIAGNOSTIC_FAILED=true
    fi
  else
    echo "  ERROR: svcOrchSpec is missing from SeldonDeployment" >&2
    DIAGNOSTIC_FAILED=true
  fi
  
  if [ "$DIAGNOSTIC_FAILED" = "true" ]; then
    echo ">>> Diagnostics indicate configuration issues. Attempting to restart model deployment..." >&2
  else
    echo ">>> Diagnostics look OK. This may be a timing issue. Waiting longer for model to connect..." >&2
  fi
  
  # Wait up to 60 seconds for consumers to appear, checking every 5 seconds
  for i in {1..12}; do
    sleep 5
    INPUT_QUEUE_CHECK=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-input" \
        --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
    INPUT_CONSUMERS_CHECK=$(echo "$INPUT_QUEUE_CHECK" | jq -r '.consumers // 0' 2>/dev/null || echo "unknown")
    if [ "$INPUT_CONSUMERS_CHECK" != "0" ] && [ "$INPUT_CONSUMERS_CHECK" != "unknown" ]; then
      echo "✓ Consumers connected after waiting ($INPUT_CONSUMERS_CHECK consumers)"
      break
    fi
    echo "  Still waiting... (attempt $i/12, consumers=$INPUT_CONSUMERS_CHECK)" >&2
  done
  
  # Re-check consumers after waiting
  INPUT_QUEUE_AFTER=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-input" \
      --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
  INPUT_CONSUMERS_AFTER=$(echo "$INPUT_QUEUE_AFTER" | jq -r '.consumers // 0' 2>/dev/null || echo "unknown")
  
  if [ "$INPUT_CONSUMERS_AFTER" != "0" ] && [ "$INPUT_CONSUMERS_AFTER" != "unknown" ]; then
    echo "✓ Consumers connected after waiting!"
  else
    echo "Still no consumers. Attempting to restart model deployment..." >&2
    kubectl rollout restart deployment.apps/iris-model-rabbitmq-default-0-classifier -n ${COMPUTE_NAMESPACE} 2>/dev/null || true
    echo "Waiting for model deployment to be ready after restart..."
    if kubectl wait deployment.apps/iris-model-rabbitmq-default-0-classifier -n ${COMPUTE_NAMESPACE} --for condition=Available=True --timeout=120s 2>/dev/null; then
      echo "Model deployment restarted and ready. Waiting for RabbitMQ connection..."
      sleep 15
      # Final check
      INPUT_QUEUE_FINAL=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-input" \
          --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
      INPUT_CONSUMERS_FINAL=$(echo "$INPUT_QUEUE_FINAL" | jq -r '.consumers // 0' 2>/dev/null || echo "unknown")
      echo "Consumers after restart: $INPUT_CONSUMERS_FINAL"
      if [ "$INPUT_CONSUMERS_FINAL" = "0" ] || [ "$INPUT_CONSUMERS_FINAL" = "unknown" ]; then
        echo "ERROR: Still no consumers after restart. This indicates a configuration issue." >&2
        echo "The model pods are not connecting to RabbitMQ. Check:" >&2
        echo "  1. RABBITMQ_BROKER_URL environment variable in model pods" >&2
        echo "  2. RABBITMQ_USERNAME and RABBITMQ_PASSWORD are set correctly" >&2
        echo "  3. Model pod logs for connection errors" >&2
      fi
    else
      echo "WARNING: Model deployment restart timed out or failed." >&2
    fi
  fi
fi

echo ">>> Waiting for model to process message..."

# Check both queues to see their status
function checkQueueStatus {
  INPUT_QUEUE_STATUS=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-input" \
      --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
  OUTPUT_QUEUE_STATUS=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-output" \
      --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
  
  INPUT_MESSAGES=$(echo "$INPUT_QUEUE_STATUS" | jq -r '.messages // 0' 2>/dev/null || echo "unknown")
  INPUT_CONSUMERS=$(echo "$INPUT_QUEUE_STATUS" | jq -r '.consumers // 0' 2>/dev/null || echo "unknown")
  OUTPUT_MESSAGES=$(echo "$OUTPUT_QUEUE_STATUS" | jq -r '.messages // 0' 2>/dev/null || echo "unknown")
  OUTPUT_CONSUMERS=$(echo "$OUTPUT_QUEUE_STATUS" | jq -r '.consumers // 0' 2>/dev/null || echo "unknown")
  
  echo "Queue status - Input: messages=$INPUT_MESSAGES, consumers=$INPUT_CONSUMERS | Output: messages=$OUTPUT_MESSAGES, consumers=$OUTPUT_CONSUMERS" >&2
  
  if [ "$INPUT_CONSUMERS" = "0" ]; then
    echo "WARNING: No consumers connected to input queue! Model may not be consuming messages." >&2
  fi
  
  if [ "$INPUT_MESSAGES" != "0" ] && [ "$INPUT_MESSAGES" != "unknown" ]; then
    echo "WARNING: Messages accumulating in input queue ($INPUT_MESSAGES messages). Model may not be processing." >&2
  fi
}

function retrieveIrisResult {
  RESPONSE=$(curl -s -X POST "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-output/get" \
      --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" \
      -H "Content-type: application/json" \
      -H "Accept: application/json" \
      -d '{"count":1,"ackmode":"ack_requeue_false","encoding":"auto"}')
  
  # Check if response is an error
  if echo "$RESPONSE" | jq -e '.error' > /dev/null 2>&1; then
    echo "Error from RabbitMQ API: $RESPONSE" >&2
    return 1
  fi
  
  # Check if response is an empty array (queue is empty)
  if echo "$RESPONSE" | jq -e 'length == 0' > /dev/null 2>&1; then
    # Queue is empty - check queue status and input queue for debugging
    QUEUE_INFO=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-output" \
        --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
    if echo "$QUEUE_INFO" | jq -e '.error' > /dev/null 2>&1; then
      echo "Queue does not exist or error accessing it: $QUEUE_INFO" >&2
    else
      MESSAGE_COUNT=$(echo "$QUEUE_INFO" | jq -r '.messages // 0' 2>/dev/null || echo "unknown")
      echo "Output queue is empty (messages: $MESSAGE_COUNT). Waiting for model response..." >&2
    fi
    # Check both queues status
    checkQueueStatus
    return 1
  fi
  
  # Extract payload from response array
  IRIS_RESULT_PAYLOAD=$(echo "$RESPONSE" | jq -e -r '.[0].payload // empty' 2>/dev/null)
  
  # Return 1 if payload is empty
  if [ -z "$IRIS_RESULT_PAYLOAD" ]; then
    echo "Response received but payload is empty: $RESPONSE" >&2
    return 1
  fi
  
  return 0
}
with_backoff retrieveIrisResult

# If we still don't have a result, provide diagnostics before exiting
if [ -z "${IRIS_RESULT_PAYLOAD:-}" ]; then
  echo ""
  echo ">>> Test failed: No response received from model"
  echo ">>> Final queue status:"
  checkQueueStatus
  echo ""
  echo ">>> Possible Issues:"
  echo "1. Model pods may have been created before RabbitMQ was ready"
  echo "   Solution: Restart the model deployment:"
  echo "   kubectl rollout restart deployment/iris-model-rabbitmq-default-0-classifier -n ${COMPUTE_NAMESPACE}"
  echo ""
  echo "2. Model pods may not have the correct RabbitMQ configuration"
  echo "   Check environment variables in model pods:"
  echo "   kubectl exec <pod-name> -n ${COMPUTE_NAMESPACE} -c classifier -- env | grep RABBITMQ"
  echo ""
  echo "3. Model pods may be failing to connect to RabbitMQ"
  echo "   Check model pod logs for connection errors:"
  echo "   kubectl logs <pod-name> -n ${COMPUTE_NAMESPACE} -c classifier | grep -i rabbitmq"
  echo ""
  echo "4. Verify RabbitMQ service is accessible from model pods:"
  echo "   kubectl exec <pod-name> -n ${COMPUTE_NAMESPACE} -c classifier -- nslookup rabbitmq-ha.rabbitmq.svc.cluster.local"
  echo ""
  echo ">>> Configuration Summary:"
  echo "Expected broker URL: amqp://seldon:<password>@rabbitmq-ha.rabbitmq.svc.cluster.local:5672"
  echo "Expected input queue: iris-model-rabbitmq-input"
  echo "Expected output queue: iris-model-rabbitmq-output"
  echo "Secret name: seldon-user-user-credentials"
  echo "Secret namespace: ${COMPUTE_NAMESPACE}"
  echo ""
  echo ">>> RabbitMQ Service Info:"
  echo "Service: rabbitmq-ha.${RABBITMQ_NAMESPACE}.svc.cluster.local"
  echo "Port: 5672"
  echo "Management API: Port 15672 (via port-forward)"
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

if [ "${EXPECTED_IRIS_RESULT_PAYLOAD}" != "${IRIS_RESULT_PAYLOAD}" ]; then
  echo "UNEXPECTED IRIS MODEL RESULT: ${IRIS_RESULT_PAYLOAD}"
  echo ""
  echo ">>> Diagnostics:"
  echo "Check model pod logs for errors:"
  for pod in $MODEL_PODS; do
    echo "  kubectl logs $pod -n ${COMPUTE_NAMESPACE} -c classifier"
  done
  echo ""
  echo "Check RabbitMQ connection:"
  echo "  kubectl exec -n ${RABBITMQ_NAMESPACE} ${RABBITMQ_POD} -c rabbitmq-ha -- rabbitmqctl list_connections"
  echo "  kubectl exec -n ${RABBITMQ_NAMESPACE} ${RABBITMQ_POD} -c rabbitmq-ha -- rabbitmqctl list_queues name messages consumers"
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

# Clean up port-forward
kill $PORT_FORWARD_PID 2>/dev/null || true
wait $PORT_FORWARD_PID 2>/dev/null || true

echo ">>> Test passed!"
