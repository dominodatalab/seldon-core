#!/bin/bash

# Test script for RabbitMQ models using rabbitmq-ha chart

set -o nounset -o errexit -o pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
MODELS_DIR=$SCRIPT_DIR/../../models
COMMON_DIR=$SCRIPT_DIR/../common

source "${COMMON_DIR}/with_backoff.sh"

COMPUTE_NAMESPACE=seldon-regression-test
RABBITMQ_NAMESPACE=rabbitmq

echo ">>> Getting RabbitMQ credentials..."
# Use seldon user for management API access (has management tag)
# seldon user credentials are in secret 'rabbitmq-ha.seldon'
RABBITMQ_USER="seldon"
RABBITMQ_PASSWORD=""

if kubectl get secret rabbitmq-ha.seldon -n ${RABBITMQ_NAMESPACE} &>/dev/null; then
  RABBITMQ_PASSWORD=$(kubectl -n ${RABBITMQ_NAMESPACE} get secret rabbitmq-ha.seldon -o jsonpath="{.data.rabbitmq-password}" | base64 --decode 2>/dev/null || echo "")
fi

# Fallback to default password if secret not found
if [ -z "$RABBITMQ_PASSWORD" ]; then
  RABBITMQ_PASSWORD="seldon-password"
fi

if [ -z "$RABBITMQ_USER" ] || [ -z "$RABBITMQ_PASSWORD" ]; then
  echo "ERROR: Could not determine RabbitMQ credentials"
  exit 1
fi

echo ">>> Getting RabbitMQ pod name..."
RABBITMQ_POD=$(kubectl get pods -n ${RABBITMQ_NAMESPACE} -l app.kubernetes.io/name=rabbitmq-ha -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo "")

if [ -z "$RABBITMQ_POD" ]; then
  echo "ERROR: RabbitMQ pod not found"
  exit 1
fi

EXPECTED_IRIS_RESULT_PAYLOAD='{"data":{"names":["t:0","t:1","t:2"],"ndarray":[[0.0006985194531162835,0.00366803903943666,0.995633441507447]]},"meta":{"requestPath":{"classifier":"seldonio/sklearnserver:1.17.1"}}}'

echo ">>> Checking if model deployment is ready..."
if ! kubectl wait deployment.apps/iris-model-rabbitmq-default-0-classifier -n ${COMPUTE_NAMESPACE} --for condition=Available=True --timeout=30s 2>/dev/null; then
  echo "WARNING: Model deployment may not be ready. Continuing anyway..."
fi

echo ">>> Setting up port-forward to RabbitMQ Management API..."
# Use port-forward to access Management API since curl is not available in container
kubectl -n ${RABBITMQ_NAMESPACE} port-forward ${RABBITMQ_POD} 15672:15672 > /dev/null 2>&1 &
PORT_FORWARD_PID=$!
sleep 2

echo ">>> Verifying queues exist..."
INPUT_QUEUE_INFO=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-input" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
OUTPUT_QUEUE_INFO=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-output" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")

if echo "$INPUT_QUEUE_INFO" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: Input queue does not exist: $INPUT_QUEUE_INFO" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

if echo "$OUTPUT_QUEUE_INFO" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: Output queue does not exist: $OUTPUT_QUEUE_INFO" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

echo ">>> Queues verified. Sending predict message to iris rabbitmq model input queue..."

PUBLISH_RESPONSE=$(curl -s -X POST "http://localhost:15672/api/exchanges/%2F/amq.default/publish" \
    --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" \
    -H "Content-type: application/json" \
    -H "Accept: application/json" \
    -d '{"properties":{"content_type":"application/json"},"routing_key":"iris-model-rabbitmq-input","payload":"{\"data\": {\"ndarray\": [[1,2,3,4]] }}","payload_encoding":"string"}')

# Check if publish was successful
if echo "$PUBLISH_RESPONSE" | jq -e '.error' > /dev/null 2>&1; then
  echo "ERROR: Failed to publish message: $PUBLISH_RESPONSE" >&2
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

echo ">>> Message published successfully. Waiting for model to process..."

function retrieveIrisResult {
  RESPONSE=$(curl -s -X POST "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-output/get" \
      --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" \
      -H "Content-type: application/json" \
      -H "Accept: application/json" \
      -d '{"count":1,"ackmode":"ack_requeue_false","encoding":"auto"}')
  
  # Check if response is an error
  if echo "$RESPONSE" | jq -e '.error' > /dev/null 2>&1; then
    echo "Error from RabbitMQ API: $RESPONSE" >&2
    return 1
  fi
  
  # Check if response is an empty array (queue is empty)
  if echo "$RESPONSE" | jq -e 'length == 0' > /dev/null 2>&1; then
    # Queue is empty - check queue status for debugging
    QUEUE_INFO=$(curl -s -X GET "http://localhost:15672/api/queues/%2F/iris-model-rabbitmq-output" \
        --user "${RABBITMQ_USER}:${RABBITMQ_PASSWORD}" 2>/dev/null || echo "{}")
    if echo "$QUEUE_INFO" | jq -e '.error' > /dev/null 2>&1; then
      echo "Queue does not exist or error accessing it: $QUEUE_INFO" >&2
    else
      MESSAGE_COUNT=$(echo "$QUEUE_INFO" | jq -r '.messages // 0' 2>/dev/null || echo "unknown")
      echo "Queue is empty (messages: $MESSAGE_COUNT). Waiting for model response..." >&2
    fi
    return 1
  fi
  
  # Extract payload from response array
  IRIS_RESULT_PAYLOAD=$(echo "$RESPONSE" | jq -e -r '.[0].payload // empty' 2>/dev/null)
  
  # Return 1 if payload is empty
  if [ -z "$IRIS_RESULT_PAYLOAD" ]; then
    echo "Response received but payload is empty: $RESPONSE" >&2
    return 1
  fi
  
  return 0
}
with_backoff retrieveIrisResult

if [ "${EXPECTED_IRIS_RESULT_PAYLOAD}" != "${IRIS_RESULT_PAYLOAD}" ]; then
  echo "UNEXPECTED IRIS MODEL RESULT: ${IRIS_RESULT_PAYLOAD}"
  kill $PORT_FORWARD_PID 2>/dev/null || true
  exit 1
fi

# Clean up port-forward
kill $PORT_FORWARD_PID 2>/dev/null || true
wait $PORT_FORWARD_PID 2>/dev/null || true

echo ">>> Test passed!"
